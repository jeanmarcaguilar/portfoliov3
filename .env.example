# Contact Form Configuration
# Get your free Formspree form ID at: https://formspree.io/
# 1. Go to https://formspree.io/
# 2. Sign up and create a new form
# 3. Copy your form ID (looks like: xyzabcde)
# 4. Replace YOUR_FORMSPREE_FORM_ID below with your actual form ID
# 5. Rename this file to .env

VITE_CONTACT_ENDPOINT=https://formspree.io/f/YOUR_FORMSPREE_FORM_ID

# Visitor Tracking Configuration
# Enable Gmail notifications for new portfolio visitors
# See docs/VISITOR_TRACKING_SETUP.md for detailed setup instructions

# Your Gmail address
GMAIL_USER=your-email@gmail.com

# Gmail App Password (generate at Google Account Security > App Passwords)
# Format: 16 characters with spaces (e.g., "abcd efgh ijkl mnop")
GMAIL_APP_PASSWORD=your-app-password-here

# Email to receive visitor notifications (optional, defaults to GMAIL_USER)
VISITOR_NOTIFICATION_EMAIL=your-email@gmail.com

# Supabase Configuration
# Get these from: https://supabase.com/dashboard → Project → Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# API Security
# Generate a strong random key for API authentication
# You can generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=your-generated-api-key-here
VITE_API_KEY=your-generated-api-key-here
